    "childCaseMonitoringCtrl" : {
      "type" : "expression",
      "value" : [
        "return {",
        "    getFlowNodeCounter: function(responseHeader) {",
        "        return responseHeader ? responseHeader['content-range'].split('/')[1] : 0;",
        "    },",
        "    getFailedFlowNodeCounter: function() {",
        "        const flowNodeCounter = this.getFlowNodeCounter($data.childCaseMonitoringData.failedSubTasksFromAPIHeaders);",
        "",
        "            if(flowNodeCounter < 1) {",
        "                return `${flowNodeCounter}`;",
        "            } else {",
        "                return `<i class=\"glyphicon glyphicon-exclamation-sign text-warning\"></i> ${flowNodeCounter}`;",
        "            }",
        "    }",
        "};"
      ],
      "exposed" : false
    },
