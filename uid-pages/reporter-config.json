{
  "reporterEnabled": "mochawesome, mocha-junit-reporter",
  "mochaJunitReporterReporterOptions": {
    "mochaFile": "build-gradle/tests/results/test-results-output.xml"
  },
  "mochawesomeReporterOptions": {
    "charts": true,
    "overwrite": false,
    "html": false,
    "json": true,
    "reportDir": "build-gradle/tests/results/mochawesome-report"
  }
}